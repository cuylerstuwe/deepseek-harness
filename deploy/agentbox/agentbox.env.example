# Persistent Harness state inside the container.
DSH_HOME=/home/agent/.dsh

# Supply addresses that are reachable from inside the Agentbox container.
UPSTAIRS_QWEN38_BASE_URL=http://upstairs-q27.example.internal:18080/v1
MTPLX_FLASH_NEXT_BASE_URL=http://m5-mtplx.example.internal:8003/v1
GX10_GLM_BASE_URL=http://gx10-head.example.internal:8000/v1

# The authenticated q27 route requires its real bearer token. The other two
# services are keyless but Harness uses non-empty credential references.
UPSTAIRS_QWEN38_API_KEY=replace-me
MTPLX_LOCAL_API_KEY=local-no-auth
GX10_GLM_API_KEY=local-no-auth

# Optional; the generated settings otherwise select gx10-glm/glm-5.3-flash.
DSH_DEFAULT_PROVIDER=gx10-glm
DSH_DEFAULT_MODEL=glm-5.3-flash
